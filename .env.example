# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Supabase: Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
# The service_role key bypasses Row Level Security: keep it server-side only
# (GitHub Actions secrets / .env.local), never in website code.
SUPABASE_SERVICE_ROLE_KEY=

# Website (week 3). Publishable key is safe to expose; RLS limits it to published stories.
SUPABASE_PUBLISHABLE_KEY=
# Password for /admin, at least 12 characters
ADMIN_PASSWORD=
# Random string shared with the pipeline so it can refresh the site
REVALIDATE_SECRET=
# Public address of the site (used for links, sitemap, RSS)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: shown as the "report an error" address
# CONTACT_EMAIL=

# AI (week 2). Free Gemini key: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Free backup AI used when Gemini is busy. Key: https://console.groq.com/keys
AI_FALLBACK_PROVIDER=groq
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Optional: models tried in order when one is busy
# GEMINI_MODELS=gemini-flash-lite-latest,gemini-flash-latest
# AI_DAILY_LIMIT=100
# STORIES_PER_RUN=6
